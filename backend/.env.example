# ==============================================================================
# SmartCart Enterprise — Backend Environment Variables
# ==============================================================================

# Supabase PostgreSQL Target Database Connection
# 
# Recommended (Connection Pooler - Transaction Mode / Port 6543):
# Ideal for serverless platforms like Render, AWS Lambda, or container deployments
# DATABASE_URL=postgresql://postgres.ieftjqijcyfvqxbxyopa:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Alternative (Connection Pooler - Session Mode / Port 5432):
# DATABASE_URL=postgresql://postgres.ieftjqijcyfvqxbxyopa:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Direct Database Connection (Direct Port 5432 - IPv6 only on standard networks):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ieftjqijcyfvqxbxyopa.supabase.co:5432/postgres?sslmode=require
#
# Default fallback if left unset: Local database in backend/ecommerce_churn.db

# Frontend Production URL (Configured for CORS in FastAPI)
# FRONTEND_URL=https://your-smartcart-frontend.vercel.app

# Server Port (Render injects $PORT automatically in production)
PORT=8000
