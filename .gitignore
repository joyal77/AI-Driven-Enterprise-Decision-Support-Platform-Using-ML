# ============================================
# SmartCart Enterprise — Production .gitignore
# ============================================

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
*.env
.env.*
backend/.env
frontend/.env
.env.local
.env.*.local
*.pem
*.key

# Allow Safe Documentation / Configuration Templates
!.env.example
!*.env.example
!backend/.env.example
!frontend/.env.example

# SQLite Databases & Backups (CRITICAL: NEVER COMMIT LOCAL DBs OR BACKUPS)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/*.db
database/backups/
database/backups/*

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Node & Frontend Dependencies & Build Output
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/.vite/
build/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python Caches & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Binary Executables & Compiler Archives
*.exe
*.zip
tools/tectonic.exe
tools/tectonic.zip

# Large Auxiliary Datasets
integrated_dataset_output/

# Logs & Temporary Files
*.log
*.tmp
*.bak

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
